<Window x:Class="MessageManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MessageManager"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="1.5*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Grid.Column="1" FlowDirection="RightToLeft"  >
        <TextBlock Text= "  נשמח לשמוע את חוות דעתך" Foreground="LightSeaGreen" FontSize="25" Height="42" Width="443" />
            <TextBlock Text=" הקש תעודת זהות " />
            <TextBox x:Name="tb1" Text="{Binding id}" />
            <TextBlock Text="הקש את חוות דעתך"/>
        <TextBox x:Name="tb2" Text="{Binding content }"/>
        <Button Content="שלח" Click="saveMessage" />
    </StackPanel>
    </Grid>
</Window>
