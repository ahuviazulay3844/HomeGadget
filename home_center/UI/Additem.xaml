<Page x:Class="home_center.UI.Additem"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:home_center.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Additem">

    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="667*"/>
            <ColumnDefinition Width="125*"/>
            <ColumnDefinition Width="8*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="7*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="לצורך הוספה עליך להקיש את פרטי המוצר" FlowDirection="RightToLeft" Foreground="White" FontSize="20" Grid.ColumnSpan="2" Margin="0,0,125,0"/>
        <StackPanel Grid.Column="0" Margin="250,40,117,0" Grid.RowSpan="2" FlowDirection="RightToLeft">
            <TextBlock Text="הקש תאור מוצר " FlowDirection="RightToLeft" Foreground="White" FontSize="17" FontWeight="Bold"/>
            <TextBox x:Name="tbi2"  Padding="27,0,0,0" BorderThickness="0,0,0,3" Margin="0,0,0,5" CaretBrush="White" BorderBrush="White" Background="Transparent"  Height="30" Foreground="White">
                <Binding Path="NameItem">
                    <Binding.ValidationRules>
                        <local:isHebrewRule2/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <TextBlock Text="הקש מחיר מוצר" FlowDirection="RightToLeft" Foreground="White" FontSize="15" FontWeight="Bold"/>
            <TextBox x:Name="tbi3"  Padding="27,0,0,0" BorderThickness="0,0,0,3" Margin="0,0,0,5" CaretBrush="White" BorderBrush="White" Background="Transparent"  Height="30" Foreground="White">
                <Binding Path="Price_base">
                    <Binding.ValidationRules>
                        <local:IsNumber/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <TextBlock Text="הקש כמות מוצר" FlowDirection="RightToLeft" Foreground="White" FontSize="15" FontWeight="Bold"/>
            <TextBox x:Name="tbi4"  Padding="27,0,0,0" BorderThickness="0,0,0,3" Margin="0,0,0,5" CaretBrush="White" BorderBrush="White" Background="Transparent"  Height="30" Foreground="White">
                <Binding Path="Amount">
                    <Binding.ValidationRules>
                        <local:IsNumber/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <TextBlock Text="קטגוריה" FlowDirection="RightToLeft" Foreground="White" FontSize="17" FontWeight="Bold"/>
            <ComboBox  x:Name="cmb"  Height="25" FlowDirection="RightToLeft" Foreground="LightSeaGreen" FontSize="20" FontWeight="Bold"  SelectedItem="{Binding Category1}"  DisplayMemberPath="Dedripition"/>
            <Button Content="בחר תמונה" FlowDirection="RightToLeft" Foreground="LightSeaGreen" FontSize="20" FontWeight="Bold" Background="White" Click="addimage" Height="48" Width="135"/>
            <Image x:Name="imageadditem" Height="96" Width="144"/>
            <Button Content="סימתי" Background="White" Foreground="LightSeaGreen" FontSize="17" FontWeight="Bold" Click="enditem" Height="40" Width="71"/>
        </StackPanel>
    </Grid>
</Page>
