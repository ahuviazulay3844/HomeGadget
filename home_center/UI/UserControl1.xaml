<UserControl x:Class="home_center.UI.UserControl1"
xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:home_center.UI"
             mc:Ignorable="d" d:DesignWidth="150" Height="207">
    <Grid Background="White">
        <StackPanel>
            <Image x:Name="imagecart" Height="100"/>
            <TextBlock x:Name="tblteur" FlowDirection="RightToLeft"  Text="{Binding NameItem}" Foreground="LightSeaGreen" FontSize="10"/>
            <StackPanel  Orientation="Horizontal"  Margin="18,0,0,0">
                <TextBlock  x:Name="tbprice" Width="50" Margin="38,2,0,0"  Background="Transparent" Text="{Binding Price_base}" FontSize="10" Foreground="LightSeaGreen"/>
                <TextBlock Width="50" Height="10" Text=":מחיר המוצר"  FontSize="8" Foreground="LightSeaGreen"  />
            </StackPanel>
            <StackPanel Height="20" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button  Content="-" FontSize="15" Background="Transparent" Foreground="LightSeaGreen" FontWeight="Bold" Click="blessitem" Width="36" Height="26" />
                <TextBlock x:Name="amount" HorizontalAlignment="Center"  Foreground="LightSeaGreen" Margin="0,0,-60,0"/>
                <Button  Content="+" FontSize="15"  Background="Transparent" Foreground="LightSeaGreen" FontWeight="Bold"  Margin="65,0,0,0" Click="badditem" Width="35" />

            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Width="150" Content="הוספת לסל" FontSize="15" Foreground="White" Background="LightSeaGreen" FontWeight="Bold" Click="addcart" Height="32" />


            </StackPanel>



            <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" FlowDirection="RightToLeft" Margin="18,4,10,5">
                <TextBlock x:Name="tblitem" FontSize="10" Text=" קוד מוצר:" Foreground="LightSeaGreen" Padding="5,0,10,0" FlowDirection="RightToLeft"  TextAlignment="Justify" FontWeight="Bold" Height="18" Width="63"/>
                <TextBlock x:Name="tbitem" Background="Transparent" Text="{Binding Code}" FlowDirection="RightToLeft" Foreground="LightSeaGreen"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
