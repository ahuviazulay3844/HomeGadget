<Page x:Class="home_center.UI.addclient2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:home_center.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="addclient2">
    <Grid>
        <Viewbox>
            <Grid  MinWidth="50" Height="392" Width="809" Opacity="0.8" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270*"/>
                    <ColumnDefinition Width="296*"/>
                    <ColumnDefinition Width="243*"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="1" Margin="81,0,3,0">
                    <StackPanel >
                        <TextBlock Text="תעודת זהות"  Foreground="White"  Padding="10,10,10,10" FlowDirection="RightToLeft" FontSize="20" FontWeight="Bold"/>
                        <TextBox x:Name="Id" FlowDirection="RightToLeft" Width="195"  Padding="27,0,0,0" BorderThickness="0,0,0,3" Margin="0,0,0,5" CaretBrush="White" BorderBrush="White" Background="Transparent"  Height="17" Foreground="White">
                            <Binding Path="Id">
                                <Binding.ValidationRules>
                                    <local:IsId/>
                                    <local:IsNumber/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox>
                        <TextBlock Text="שם פרטי"  Foreground="White" Padding="10,10,10,10" FlowDirection="RightToLeft" FontSize="20" FontWeight="Bold"/>
                        <TextBox x:Name="FirstName" FlowDirection="RightToLeft"  Padding="27,0,0,0" BorderThickness="0,0,0,3" Margin="0,0,0,5" CaretBrush="White" BorderBrush="White" Background="Transparent"  Height="30" Foreground="White">
                            <Binding Path="FirstName">
                                <Binding.ValidationRules>
                                    <local:isHebrewRule2/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox>
                        <TextBlock Text="שם משפחה"  Foreground="White" Padding="10,10,10,10" FlowDirection="RightToLeft" FontSize="20" FontWeight="Bold"/>
                        <TextBox x:Name="LastName" FlowDirection="RightToLeft"  Padding="27,0,0,0" BorderThickness="0,0,0,3" Margin="0,0,0,5" CaretBrush="White" BorderBrush="White" Background="Transparent"  Height="30" Foreground="White" >
                            <Binding Path="LastName">
                                <Binding.ValidationRules>
                                    <local:isHebrewRule2/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox>
                        <TextBlock Text="טלפון"  Foreground="White" Padding="10,10,10,10" FlowDirection="RightToLeft" FontSize="20" FontWeight="Bold"/>
                        <TextBox x:Name="Phone" FlowDirection="RightToLeft"  Padding="27,0,0,0" BorderThickness="0,0,0,3" Margin="0,0,0,5" CaretBrush="White" BorderBrush="White" Background="Transparent"  Height="30" Foreground="White">
                            <Binding Path="Phone">
                                <Binding.ValidationRules>
                                    <local:IsNumber/>
                                    <local:IsCellPhone/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox>
                        <TextBlock Text="אימיל"  Foreground="White" Padding="10,10,10,10" FlowDirection="RightToLeft" FontSize="20" FontWeight="Bold"/>
                        <TextBox x:Name="Email"  Padding="27,0,0,0" BorderThickness="0,0,0,3" Margin="0,0,0,5" CaretBrush="White" BorderBrush="White" Background="Transparent"  Height="28" Foreground="White" Width="193"   >
                            <Binding Path="Email">
                                <Binding.ValidationRules>
                                    <local:EmailRule2/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox>
                        <TextBlock Text="תאריך לידה"  Foreground="White" Padding="10,10,10,10" FlowDirection="RightToLeft" FontSize="20" FontWeight="Bold"/>
                        <DatePicker x:Name="Dateofbirth" SelectedDate="{Binding Dateofbirth}" />
                        <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" >
                            <Button x:Name="end2" Content="סיימתי" Background="LightSeaGreen" Foreground="White" FontSize="20" FontWeight="Bold" Click="endd2" Height="50" Width="138"  />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Viewbox>
    </Grid>
</Page>
