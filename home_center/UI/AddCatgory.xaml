<Page x:Class="home_center.UI.AddCatgory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:home_center.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddCatgory">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1">
            <TextBlock Text="הקש קטגוריה" Foreground="White" FlowDirection="RightToLeft" FontSize="25"/>
            <TextBox x:Name="catgory" Height="27" FlowDirection="RightToLeft" Width="195" FontSize="25" Foreground="LightSeaGreen">
                <Binding Path="Dedripition">
                    <Binding.ValidationRules>
                        <local:isHebrewRule2/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <Button Content="אישור" Foreground="LightSeaGreen" FontSize="25"  Background="Transparent" Height="40" Width="312" Click="Catgory1"/>
        </StackPanel>
    </Grid>
</Page>
