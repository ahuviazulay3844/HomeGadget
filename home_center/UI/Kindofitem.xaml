<Page x:Class="home_center.UI.Kindofitem"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:home_center.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Kindofitem">
    <Grid Background="LightSeaGreen" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4.5*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ListView x:Name="lv3" Grid.Row="1" Grid.Column="0" FlowDirection="RightToLeft"  Margin="10,10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="85" Header="קוד מוצר" DisplayMemberBinding="{Binding Code}"/>
                    <GridViewColumn Width="85" Header="שם מוצר" DisplayMemberBinding="{Binding NameItem}" />
                    <GridViewColumn Width="85" Header="מחיר מוצר" DisplayMemberBinding="{Binding Price_base}"/>
                    <GridViewColumn Width="85" Header="כמות במלאי" DisplayMemberBinding="{Binding Amount}"/>
                    <GridViewColumn Width="85" Header="קטגוריה" DisplayMemberBinding="{Binding Category}"/>
                    <GridViewColumn Width="85" Header="תמונה" DisplayMemberBinding="{Binding NameImage}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel Grid.Column="1" Background="White">
            <Button x:Name="addclient1" Content="הוספת מוצר" Grid.Column="1" Grid.Row="1" Margin="10,150,10,0" FontWeight="Bold" Foreground="White"  Background="LightSeaGreen" Height="42" Width="106" Click="additem" />
            <Button x:Name="deleteclient1" Content=" מחיקת מוצר" Grid.Column="1" Grid.Row="1" Margin="10,20" FontWeight="Bold" Foreground="White"  Background="LightSeaGreen" Height="42" Width="106" Click="delete"/>
            <Button x:Name="updateclient1" Content="עידכון פרטי מוצר" FontWeight="Bold" FontSize="11" Foreground="White"  Background="LightSeaGreen"  Height="42" Width="106" Click="updateitem"  />
        </StackPanel>
    </Grid>
</Page>

