<Page x:Class="home_center.UI.OrderClient"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:home_center.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderClient">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="21*"/>
                <RowDefinition Height="128*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="רשימת הזמנות" Foreground="White" FontSize="35" Margin="0,5,0,5" FontWeight="Bold" HorizontalAlignment="Center" Width="232" />
            <ScrollViewer Grid.Row="1">
                <StackPanel Grid.Row="1">
                
                    <ListView x:Name="lvo" FlowDirection="RightToLeft"  Margin="10">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="קוד" Width="100" DisplayMemberBinding="{Binding CodeOrder}"/>
                            <GridViewColumn Header="תאריך הזמנה" Width="110" DisplayMemberBinding="{Binding DateOrder}"/>
                            <GridViewColumn Header="תעודת זהות" Width="140" DisplayMemberBinding="{Binding Id}"/>
                            <GridViewColumn Header="מחיר קניה" Width="140" DisplayMemberBinding="{Binding PriceEnd}"/>
                            <GridViewColumn Header="שם פרטי" Width="100" DisplayMemberBinding="{Binding Client.FirstName}"/>
                            <GridViewColumn Header="שם משפחה" Width="120" DisplayMemberBinding="{Binding Client.LastName}"/>
                            <GridViewColumn Header="טלפון" Width="120" DisplayMemberBinding="{Binding Client.Phone}"/>
                            <GridViewColumn Header="חבר מועדון" Width="100" DisplayMemberBinding="{Binding Client.Member}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
              
            </StackPanel>
            </ScrollViewer>
        </Grid>
        <Button Height="35" Width="85" Content="פרטי הזמנה" Click="itemorder" RenderTransformOrigin="-2.63,10.812" Margin="0,350,550,0" />
    </Grid>
</Page>

