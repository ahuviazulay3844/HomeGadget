<Page x:Class="home_center.UI.Pageofitem"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:home_center.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Pageofitem">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="639*"/>
            <ColumnDefinition Width="161*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="6*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.Row="0">
            <Button x:Name="tocast" Content="לסל קניות" Background="LightSeaGreen" Width="80" Click="tocast_Click"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="1" x:Name="stk1">
            
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <WrapPanel x:Name="WrpofCart" />

        </ScrollViewer>
    </Grid>   
</Page>
