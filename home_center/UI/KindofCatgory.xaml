<Page x:Class="home_center.UI.KindofCatgory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:home_center.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="KindofCatgory">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4.5*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ListView x:Name="lv6" Grid.Row="1" Grid.Column="0" FlowDirection="RightToLeft"  Margin="10,10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="85" Header="קוד קטגוריה" DisplayMemberBinding="{Binding Code}"/>
                    <GridViewColumn Width="85" Header="תאור קטגוריה" DisplayMemberBinding="{Binding Dedripition}" />
                    <GridViewColumn Width="85" Header="סטטוס" DisplayMemberBinding="{Binding Status}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel Grid.Column="1" Background="White">
            <Button  Content="הוספת קטגוריה" Grid.Column="1" Grid.Row="1" Margin="10,150,10,0" FontWeight="Bold" Foreground="White"  Background="LightSeaGreen" Width="126" Click="addcatgory" Height="42" />
            <Button  Content=" מחיקת קטגוריה" Grid.Column="1" Grid.Row="1" Margin="10,20" FontWeight="Bold" Foreground="White"  Background="LightSeaGreen" Click="deletecatgory" Height="39" Width="125"  />
            <!--<Button  Content="עידכון קטגוריה" FontWeight="Bold" FontSize="11" Foreground="White"  Background="LightSeaGreen"  Height="21" Width="95" Click="updatecatgory"  />-->
        </StackPanel>
    </Grid>
</Page>
