<UserControl x:Class="home_center.UI.UserControl2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:home_center.UI"
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="750">
    <UserControl.Resources>
        <local:ConvertToSum x:Key="con"/>
    </UserControl.Resources>
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition />
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Image x:Name="img1" Stretch="Uniform" Width="181" Height="100" Grid.Column="2" Margin="0,5,0,-5"/>
        <Button Content="מחק" BorderBrush="LightSeaGreen" Background="White" Foreground="LightSeaGreen" Grid.Column="0" FontSize="15" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="9,0,0,8" Height="31" Width="63" Click="cartdel"/>
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="0,20,0,50" Width="193">
            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Right"  Width="308">
                <TextBlock Text="קוד מוצר:" Height="16"  FontWeight="Bold"  Foreground="LightSeaGreen" TextAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding Code}" FlowDirection="RightToLeft" Height="15"   Width="70" Foreground="LightSeaGreen" FontSize="12"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Right">
                <TextBlock Text="שם מוצר:" Height="16"   Foreground="LightSeaGreen" FontWeight="Bold"  TextAlignment="Center" HorizontalAlignment="Right"  />
                <TextBlock Text="{Binding Item.NameItem}" Height="21"  FlowDirection="RightToLeft" Foreground="LightSeaGreen" Width="243" FontSize="12" Margin="4,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,21,0">
                <TextBlock x:Name="tblamount" Text="כמות:"  Height="16"  Foreground="LightSeaGreen" FontWeight="Bold" Margin="0,0,10,0" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Amount}" Height="16"  FlowDirection="RightToLeft"  Width="55" Margin="0,0,0,0" Foreground="LightSeaGreen" FontSize="12"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Grid.Column="1" HorizontalAlignment="Right" >
                <TextBlock Text="מחיר ליחידה:" Foreground="LightSeaGreen" Height="16"  FontWeight="Bold" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Item.Price_base}" FlowDirection="RightToLeft" Height="16" Width="49"  Foreground="LightSeaGreen" FontSize="12" Margin="5,0,0,0" />

            </StackPanel>
            <StackPanel FlowDirection="RightToLeft" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="מחיר כולל:" Height="16"  Foreground="LightSeaGreen" FontWeight="Bold" />
                <TextBlock Text="{Binding Converter={StaticResource con},Mode=OneWay}"  Foreground="LightSeaGreen" FontSize="12"  FlowDirection="RightToLeft" Height="14"  Width="52" Margin="7,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>

