<Page x:Class="home_center.UI.director"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:home_center.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="director">
    <Border>
        <Border.Background>
            <ImageBrush ImageSource="/UI/IMG-20240523-WA0010.jpg"/>
        </Border.Background>
        <Grid>
            <Border Opacity="0.6">
                <Border.Background>
                    <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                        <GradientStop Color="#FFFFFCFE" Offset="0.7775"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12*"/>
                </Grid.RowDefinitions>
                <Menu Grid.Row="0" FlowDirection="RightToLeft" FontSize="20" x:Name="menu2"   >
                    <MenuItem Tag="1" Header="דף הבית" Foreground="LightSeaGreen" Click="HomePage"/>
                    <MenuItem Header="לקוחות" Foreground="LightSeaGreen" Click="clientofdirector"/>
                    <MenuItem Header="סוגי מוצרים" Foreground="LightSeaGreen" Click="kindofitem"/>
                    <MenuItem Header="הזמנות" Foreground="LightSeaGreen" Click="Order"/>
                    <MenuItem Header="סוגי קטגוריות" Foreground="LightSeaGreen" Click="kindofcatgory"/>
                    <MenuItem Header=" צפיה בחוות דעת" Foreground="LightSeaGreen" Click="Opinion"/>
                </Menu>
                <Frame x:Name="myframe2" Grid.Row="1" Opacity="0.8" />
            </Grid>
        </Grid>
    </Border>
</Page>


