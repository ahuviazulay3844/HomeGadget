<Page x:Class="home_center.UI.payment"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:home_center.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="payment">
    <Viewbox>
        <Grid Background="White" FlowDirection="RightToLeft">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition  />
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                <TextBlock Text="עלות הקניה עד כה:" Height="36" Width="194" FlowDirection="RightToLeft" Foreground="LightSeaGreen" FontSize="20" Padding="5,5" FontWeight="Bold"/>
                <TextBlock x:Name="sum1" Height="20"  Width="277" Foreground="LightSeaGreen" FontSize="15"/>
            </StackPanel>
            <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal" FlowDirection="RightToLeft">
                <TextBlock Text="בקניה זו חסכת:" Height="36" Width="164" FlowDirection="RightToLeft" Foreground="LightSeaGreen" FontSize="20" Padding="5,5" FontWeight="Bold"/>
                <TextBlock   Height="20" Width="81" x:Name="howmutch" Foreground="LightSeaGreen" FontSize="15"/>
                <TextBlock Text="שקלים" Height="31" Width="209" FlowDirection="RightToLeft" Foreground="LightSeaGreen" FontSize="20" Padding="5,5" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Grid.Row="2">
                <TextBlock Text="סך הכל לתשלום לאחר הנחה:" Height="34" Width="282" FlowDirection="RightToLeft" Foreground="LightSeaGreen" FontSize="20" Padding="5,5" FontWeight="Bold"/>
                <TextBlock Height="21" Width="112" FontSize="15" Text="{Binding PriceEnd}"  x:Name="howmutchafter" Foreground="LightSeaGreen" />
            </StackPanel>
            <StackPanel x:Name="stpPay" Orientation="Vertical" FlowDirection="RightToLeft" Grid.Row="3">
                <TextBlock Text="אנא הזן פרטים לצורך תשלום:" FlowDirection="RightToLeft" Height="33" Width="265" Foreground="LightSeaGreen" FontSize="20" HorizontalAlignment="Left"/>
                <TextBlock Text="הקש מספר כרטיס"  FlowDirection="RightToLeft" Foreground="LightSeaGreen" FontSize="20" Padding="5,5" />
                <TextBox x:Name="mscard" BorderBrush="LightSeaGreen" Width="140" HorizontalAlignment="Left" Margin="0,0,0,0" FontSize="15"  />
                <TextBlock Text="הקש תוקף כרטיס"  FlowDirection="RightToLeft" Foreground="LightSeaGreen" FontSize="20" Padding="5,5" />
                    <StackPanel  Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Width="250" FlowDirection="RightToLeft" Height="30" Margin="0,0,0,-3" VerticalAlignment="Bottom">
                        <ComboBox x:Name="tocef" Background="LightSeaGreen" Margin="5" Width="100" FlowDirection="RightToLeft" SelectedItem="{Binding StyleChild}" SelectionChanged="tocef_SelectionChanged">
                            <ComboBoxItem Content="ינואר(1)"/>
                            <ComboBoxItem Content="פברואר(2)"/>
                            <ComboBoxItem Content="מרץ(3)"/>
                            <ComboBoxItem Content="אפריל(4)"/>
                            <ComboBoxItem Content="מאי(5)"/>
                            <ComboBoxItem Content="יוני(6)"/>
                            <ComboBoxItem Content="יולי(7)"/>
                            <ComboBoxItem Content="אוגוסט(8)"/>
                            <ComboBoxItem Content="ספטמבר(9)"/>
                            <ComboBoxItem Content="אוקטובר(10)"/>
                            <ComboBoxItem Content="נובמבר(11)"/>
                            <ComboBoxItem Content="דצמבר(12)"/>
                        </ComboBox>
                        <ComboBox x:Name="cmbYear" Background="#FFF97474" Margin="5" Width="100" FlowDirection="RightToLeft" SelectionChanged="cmbYear_SelectionChanged" Height="24">

                        </ComboBox>
                    </StackPanel>
                <TextBlock Text="הקש 3 ספרות בגב הכרטיס"  FlowDirection="RightToLeft" Foreground="LightSeaGreen" FontSize="20" Padding="5,5" />
                <TextBox x:Name="sfarot" Height="24" Width="140" Margin="0,0,700,0" FontSize="15" BorderBrush="LightSeaGreen" Foreground="LightSeaGreen" SelectionChanged="sfarot3" />
                <TextBlock x:Name="tbms"  Text="הקש מספר תשלומים"  FlowDirection="RightToLeft" Foreground="LightSeaGreen" FontSize="20" Padding="5,5" />
                <ComboBox x:Name="mstaslomim" Height="20" Margin="0,0,700,0" FontSize="15" BorderBrush="LightSeaGreen" Foreground="LightSeaGreen" Width="144" >
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                </ComboBox>
                <StackPanel >
                    <TextBlock Text=" הקש תעודת זהות של בעל הכרטיס " FontSize="20"/>
                    <TextBox x:Name="idcard" Height="5" FontSize="20"  HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" Width="219">
                    </TextBox>
                </StackPanel>
                <Button Content="סימתי" Background="LightSeaGreen" Foreground="White" FontSize="15" FontWeight="Bold" Click="end3"/>

            </StackPanel>
            <StackPanel TextElement.FontSize="20" TextElement.Foreground="LightSeaGreen" Grid.Column="1" FlowDirection="RightToLeft" TextElement.FontWeight="Bold"  Grid.Row="0" x:Name="sp7">
                <TextBlock Text="אנא הזן פרטים לצורך משלוח"/>
                <TextBlock Text="אנא הזן עיר מגורים"/>
                <ComboBox x:Name="city" Foreground="LightSeaGreen"  DisplayMemberPath="NameCity"  Text="{Binding City.NameCity}" SelectionChanged="city_SelectionChanged"/>
                <TextBlock Text="אנא הזן כתובת"/>
                <TextBox x:Name="tb7" Foreground="LightSeaGreen">
                    <Binding Path="Client.Stree">
                        <Binding.ValidationRules>
                            <local:isHebrewRule2/>
                            <local:IsNumber/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox>
                <TextBlock Text="אנא הזן מס דירה"/>
                <TextBox x:Name="tb8" Foreground="LightSeaGreen">
                    <Binding Path="Client.HouseNumber">
                        <Binding.ValidationRules>
                            <local:IsNumber/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox>
            </StackPanel>
        </Grid>
    </Viewbox>
</Page>
