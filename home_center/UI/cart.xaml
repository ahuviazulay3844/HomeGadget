<Page x:Class="home_center.UI.cart"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:home_center.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="cart">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="הסל שלי" FontSize="20" FontWeight="Bold" Foreground="LightSeaGreen" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="5"/>
        <ScrollViewer Grid.Row="1" Grid.Column="1" Grid.RowSpan="2">
            <StackPanel x:Name="stp1">

            </StackPanel>
        </ScrollViewer>
        <Button Content="לתשלום"  BorderThickness="2" Foreground="LightSeaGreen" FontSize="20" Height="50" FontWeight="Bold" BorderBrush="Transparent" Background="White" Click="forcast" Grid.Row="3"/>
    </Grid></Page>
