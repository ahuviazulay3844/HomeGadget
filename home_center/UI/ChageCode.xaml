<Page x:Class="home_center.UI.ChageCode"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:home_center.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ChageCode">
    <Grid Background="White">
        <StackPanel >
            <TextBlock x:Name="tbl1" Text="הקש קוד מנהל" FlowDirection="RightToLeft" TextAlignment="Center" FontSize="40" HorizontalAlignment="Center" Margin="0,58,0,0" Foreground="LightSeaGreen"/>
            <PasswordBox x:Name="Pb1" Height="20" Width="100" Margin="0,0,0,0"/>
            <Button x:Name="b1" Background="LightSeaGreen"  Height="55" Width="100" Content="אישור" FontSize="25"  Margin="10,100,580,0" Foreground="White" BorderBrush="White" Click="ChangeCode"/>
            <TextBlock x:Name="tbl2" Text="הקש קוד שברצונך להחליף" FlowDirection="RightToLeft" TextAlignment="Center" FontSize="40" HorizontalAlignment="Center" Margin="0,58,0,0" Foreground="LightSeaGreen"  Visibility="Collapsed"/>
            <PasswordBox x:Name="Pb2" Height="20" Width="100" Margin="0,0,0,0"  Visibility="Collapsed"/>
            <Button x:Name="b2" Background="LightSeaGreen"  Height="55" Width="100" Content="אישור" FontSize="25"  Margin="10,100,580,0" Foreground="White" BorderBrush="White" Click="againe1"  Visibility="Collapsed" />
            <TextBlock x:Name="tbl3" Text="הקש פעם נוספת לאימות" FlowDirection="RightToLeft" TextAlignment="Center" FontSize="40" HorizontalAlignment="Center" Margin="0,58,0,0" Foreground="LightSeaGreen"  Visibility="Collapsed"/>
            <PasswordBox x:Name="Pb3" Height="20" Width="100" Margin="0,0,0,0"  Visibility="Collapsed"/>
            <Button x:Name="b3" Background="LightSeaGreen"  Height="55" Width="100" Content="אישור" FontSize="25"  Margin="10,100,580,0" Foreground="White" BorderBrush="White"   Visibility="Collapsed" Click="again" />
        </StackPanel>
    </Grid>
</Page>
