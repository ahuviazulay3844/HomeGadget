<Page x:Class="home_center.UI.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:home_center.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">
    <!--<Grid>-->
    <Border>
        <Border.Background>
            <ImageBrush ImageSource="/UI/IMG-20240523-WA0010.jpg"/>
        </Border.Background>

        <Grid>
            <Border Opacity="0.6">
                <Border.Background>
                    <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                        <GradientStop Color="#FFFFFCFE" Offset="0.7775"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12*"/>
                </Grid.RowDefinitions>
                <Menu Grid.Row="0" FlowDirection="RightToLeft" FontSize="20" x:Name="menu1"   >
                    <MenuItem Tag="1" Header="מנהל" Foreground="LightSeaGreen" Click="DirectorClick"  />
                    <MenuItem Header="אודות" Foreground="LightSeaGreen" Click="about"/>
                    <MenuItem Header="המוצרים שלנו" Foreground="LightSeaGreen" Click="Ouritem"/>
                    <MenuItem Header="כניסה לסל" Foreground="LightSeaGreen" Click="CartofItem1"/>
                    <MenuItem Header="עידכון פרטים" Foreground="LightSeaGreen" Click="UpDate"/>
                    <MenuItem Header="הצטרפות למועדון" Foreground="LightSeaGreen" Click="club" />
                </Menu>
                <Frame x:Name="mainframe" Margin="0,64,0,41" Grid.RowSpan="2" />
            </Grid>
        </Grid>
    </Border>
</Page>
