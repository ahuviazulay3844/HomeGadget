<Page x:Class="home_center.UI.ClientOfDirector"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:home_center.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ClientOfDirector">
    <Border BorderBrush="LightSeaGreen" BorderThickness="10">
    <Grid Background="White" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4.5*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListView x:Name="lv1" Grid.Row="1" Grid.Column="0" FlowDirection="RightToLeft"  Margin="10,10">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="85" Header="תעודת זהות" DisplayMemberBinding="{Binding Id}"/>
                        <GridViewColumn Width="85" Header="שם פרטי" DisplayMemberBinding="{Binding FirstName}"/>
                        <GridViewColumn Width="85" Header="שם משפחה" DisplayMemberBinding="{Binding LastName}"/>
                        <GridViewColumn Width="85" Header="טלפון" DisplayMemberBinding="{Binding Phone}"/>
                        <GridViewColumn Width="85" Header="מייל" DisplayMemberBinding="{Binding Email}"/>
                        <GridViewColumn Width="85" Header="שם עיר" DisplayMemberBinding="{Binding City1.NameCity}"/>
                        <GridViewColumn Width="85" Header="רחוב" DisplayMemberBinding="{Binding Stree}"/>
                        <GridViewColumn Width="85" Header="תאריך לידה" DisplayMemberBinding="{Binding Dateofbirth}"/>
                        <GridViewColumn Width="75" Header="חבר מועדון" DisplayMemberBinding="{Binding Member}" />
                    </GridView> 
                </ListView.View>
            </ListView>
            <Frame x:Name="frame3" Grid.Row="1"/>
        
            <StackPanel Grid.Column="1" Background="White" HorizontalAlignment="Right">
                <TextBlock Text=":חיפוש לפי תעודת זהות" FontSize="11" Foreground="LightSeaGreen" FontWeight="Bold" Margin="10"/>
            <StackPanel Orientation="Horizontal">
                <TextBox  x:Name="SearchbyID" FontSize="12" BorderBrush="LightSeaGreen" Height="16" Width="115" Margin="7,0,-8,0" TextChanged="SearchbyID_TextChanged"/>
                </StackPanel>
            <StackPanel>
                <TextBlock x:Name="textBlock" Text=":חיפוש לפי טלפון" FlowDirection="RightToLeft" Foreground="#FF23B9BE" FontWeight="Bold" Margin="10" FontFamily="Bodoni MT Black" LineHeight="20" RenderTransformOrigin="2,0.5" ForceCursor="True" OverridesDefaultStyle="True" AutomationProperties.ItemStatus="{Binding Margin, ElementName=textBlock}">
                    <TextBlock.TextEffects>
                        <TextEffect>
                            <TextEffect.Foreground>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="Black"/>
                                    <GradientStop Color="White" Offset="1"/>
                                </LinearGradientBrush>
                            </TextEffect.Foreground>
                        </TextEffect>
                    </TextBlock.TextEffects>
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform X="5"/>
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Width="127">
                <TextBox x:Name="Searchbyphone" FontSize="12" BorderBrush="LightSeaGreen" Height="13" Width="115" Margin="7,0,-8,0"  TextChanged="Searchbyph_TextChanged"  />
            </StackPanel>
            </StackPanel>
        </StackPanel>
        </Grid>
    </Border>
</Page>
