<Page x:Class="home_center.UI.ItemOrder1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:home_center.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ItemOrder1">
    <Page.Resources>
        <local:ConvertToSum x:Key="con"/>
    </Page.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="5*"/>
                <RowDefinition Height="1.2*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="פרטי הזמנת לקוח" Foreground="White" FontSize="35" Margin="5" FontWeight="Bold" HorizontalAlignment="Center" />
            <StackPanel  Grid.Row="1"  >
            <ListView x:Name="lvo2"  FlowDirection="RightToLeft"  >
                <ListView.View>
                        <GridView>
                        <GridViewColumn Header=" קוד מוצר" Width="100" DisplayMemberBinding="{Binding Item.Code}"/>
                        <GridViewColumn Header="תאור מוצר" Width="110" DisplayMemberBinding="{Binding Item.NameItem}"/>
                        <GridViewColumn Header="כמות" Width="140" DisplayMemberBinding="{Binding Amount}"/>
                        <GridViewColumn Header="מחיר ליחידה" Width="140" DisplayMemberBinding="{Binding Item.Price_base}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </Grid>
</Page>
