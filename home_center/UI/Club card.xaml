<Page x:Class="home_center.UI.Club_card"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:home_center.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Club_card">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1">
            <TextBlock Text="לצורך זיהוי משתמש יש להקיש תעודת זהות" FlowDirection="RightToLeft" Foreground="White" FontSize="25" TextAlignment="Center" FontWeight="Bold"/>
            <TextBox x:Name="tbclub" Width="170" BorderBrush="WhiteSmoke"  Padding="27,0,0,0" BorderThickness="0,0,0,3" Margin="0,0,0,5" CaretBrush="White" Background="Transparent"  Height="30" Foreground="White"/>
            <Button Content="סימתי" Background="Transparent" Foreground="LightSeaGreen" FontSize="20" FontWeight="Bold" BorderBrush="Transparent" Click="endclub" Height="45"/>
        </StackPanel>
    </Grid>
</Page>
